# Polygon.io API Configuration
#
# 1) Copy this file to `.env`
#    cp .env.example .env
#
# 2) Put your Polygon API key below (Indices data required for SPX/VIX).
#
# Security:
# - Never commit `.env` files
# - This repo reads the key only from environment variables

VITE_POLYGON_API_KEY=YOUR_API_KEY_HERE

# Back-compat (optional): if you already use this env var, the app will fall back to it.
VITE_MASSIVE_API_KEY=

# Backend-only secret (recommended). If set, frontend does NOT need any key.
MASSIVE_API_KEY=YOUR_API_KEY_HERE

# Optional: override provider websocket URL (advanced)
# MASSIVE_WS_INDICES_URL=wss://socket.polygon.io/indices
# MASSIVE_WS_STOCKS_URL=wss://socket.polygon.io/stocks
# MASSIVE_WS_OPTIONS_URL=wss://socket.polygon.io/options

# Optional: protect the proxy (recommended if deployed)
# PROXY_TOKEN=change-me
# Frontend must set: VITE_PROXY_TOKEN=change-me
VITE_PROXY_TOKEN=

# NOTE: Do NOT put keys in VITE_* vars for production.
# VITE_* vars are exposed to the browser by Vite.

# Optional: enable real-data recording for backtesting (JSONL)
# RECORD_PATH=./server/data/record.jsonl

# Pro-trader tuning (optional)
# HEADSUP_MIN_SCORE=60
# TRIGGER_MIN_SCORE=65
# HEADSUP_COOLDOWN_MS=20000
# TRIGGER_COOLDOWN_MS=60000
# MAX_TRIGGERS_PER_DAY=26
# MAX_HEADSUP_PER_DAY=250
# MIN_DEALER_AGREEMENT=45
# TICK_FRESH_MS=8000
# FLOW_FRESH_MS=6000
# DEALER_FRESH_MS=45000
# BAR_FRESH_MS=150000
# OPTIONS_POLL_MS=20000
# FLOW_WINDOW_SEC=15
# STOP_MIN_PTS=8
# STOP_ATR_MULT=0.5
# STOP_BUFFER_PTS=2
# TP1_PTS=10
# TP2_PTS=15
# TP3_PTS=25
# TRADE_TTL_MIN=60

