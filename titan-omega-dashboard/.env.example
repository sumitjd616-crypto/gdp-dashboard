# Polygon.io API Configuration
#
# 1) Copy this file to `.env`
#    cp .env.example .env
#
# 2) Put your Polygon API key below (Indices data required for SPX/VIX).
#
# Security:
# - Never commit `.env` files
# - This repo reads the key only from environment variables

VITE_POLYGON_API_KEY=YOUR_API_KEY_HERE

# Back-compat (optional): if you already use this env var, the app will fall back to it.
VITE_MASSIVE_API_KEY=

# Backend-only secret (recommended). If set, frontend does NOT need any key.
MASSIVE_API_KEY=YOUR_API_KEY_HERE

# Optional: override provider websocket URL (advanced)
# MASSIVE_WS_INDICES_URL=wss://socket.polygon.io/indices

