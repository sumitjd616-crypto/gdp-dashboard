###############################################
# API integration (DO NOT commit real secrets) #
###############################################
#
# Copy this file to ".env" and fill in values:
#   cp .env.example .env
#
# ".env" is already gitignored in this repo.
#

# Base URL for the local/remote API you call from scripts.
# Example endpoints used elsewhere:
#   GET ${API_BASE_URL}/health
#   GET ${API_BASE_URL}/api/status
API_BASE_URL=http://localhost:8787

# Authentication (leave blank if your API is unauthenticated).
# Recommended: use a scoped token with the least privileges needed.
API_AUTH_HEADER=Authorization
API_AUTH_SCHEME=Bearer
API_TOKEN=

# Network safety defaults for scripts.
API_TIMEOUT_SECONDS=10
API_CONNECT_TIMEOUT_SECONDS=3
API_RETRIES=2
API_RETRY_BACKOFF_SECONDS=0.5

# TLS / certificate settings (mostly for https:// base URLs).
API_VERIFY_TLS=true
# Optional: path to a CA bundle file if using a private CA.
API_CA_BUNDLE=

# Optional: set a stable user agent for logging/allowlists.
API_USER_AGENT=local-scripts/1.0
